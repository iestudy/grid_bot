# /etc/systemd/system/grid_bot_trading_decision.service として配置する。
# Claudeに取引モードを判断させ、結果を適用する(--apply)。

[Unit]
Description=grid_bot trading mode decision (Claude)
After=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/grid_bot
EnvironmentFile=/home/ec2-user/grid_bot/.env
ExecStart=/home/ec2-user/grid_bot/venv/bin/python3 scripts/decide_trading_mode.py --apply
StandardOutput=journal
StandardError=journal
SyslogIdentifier=grid_bot_trading_decision
TimeoutStartSec=300
