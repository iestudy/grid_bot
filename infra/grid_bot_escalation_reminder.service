# /etc/systemd/system/grid_bot_escalation_reminder.service として配置する。
# エスカレーション後、botが停止したままの間、一定間隔で再通知する。

[Unit]
Description=grid_bot escalation reminder
After=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/grid_bot
EnvironmentFile=/home/ec2-user/grid_bot/.env
ExecStart=/home/ec2-user/grid_bot/venv/bin/python3 scripts/remind_escalation.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=grid_bot_escalation_reminder
